---
import { Image } from "astro:assets";
import { categories, menuItems, type Locale } from "../data/menu";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<nav class="category-nav" aria-label={locale === "es" ? "Categorías de la carta" : "Menu categories"}>
  <div class="category-nav__inner shell">
    {categories.map((category) => (
      <a href={`#${category.id}`}>{category.label[locale]}</a>
    ))}
  </div>
</nav>

<div class="menu-sections shell">
  {categories.map((category, categoryIndex) => {
    const items = menuItems.filter((item) => item.category === category.id);
    return (
      <section class="menu-section" id={category.id} aria-labelledby={`${category.id}-title`}>
        <header class="menu-section__header">
          <span>{String(categoryIndex + 1).padStart(2, "0")}</span>
          <h2 id={`${category.id}-title`}>{category.label[locale]}</h2>
        </header>
        <div class="menu-list">
          {items.map((item) => (
            <article class:list={["menu-item", { "menu-item--with-image": item.image }]}>
              {item.image && item.imageAlt && (
                <Image
                  class="menu-item__image"
                  src={item.image}
                  alt={item.imageAlt[locale]}
                  widths={[220, 360]}
                  sizes="(max-width: 719px) 32vw, 180px"
                  loading="lazy"
                />
              )}
              <div class="menu-item__content">
                <div class="menu-item__line">
                  <h3>{item.name[locale]}</h3>
                  <span class="menu-item__rule" aria-hidden="true"></span>
                  <div class="menu-item__prices">
                    {item.prices.map((price) => (
                      <span>
                        {price.label && <small>{price.label[locale]}</small>}
                        {price.amount}
                      </span>
                    ))}
                  </div>
                </div>
                <p>{item.description[locale]}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}
</div>
