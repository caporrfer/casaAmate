---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.jpg";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["brand", { "brand--compact": compact }]}>
  <Image class="brand__mark" src={logo} alt="" width={52} height={52} />
  <span class="brand__text">
    <span class="brand__name">Casa Amate</span>
    <span class="brand__descriptor">Restaurante · Jaén</span>
  </span>
</span>
