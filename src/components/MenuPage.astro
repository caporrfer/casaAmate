---
import { COPY, RESTAURANT } from '../data/site';
import { MENU } from '../data/menu';
import type { Locale } from '../types';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const copy = COPY[lang];
---

<section class="menu-hero page-shell">
  <p class="eyebrow">{copy.menuEyebrow}</p>
  <h1>{copy.menuTitle}</h1>
  <p>{copy.menuIntro}</p>
</section>

<nav class="menu-index" aria-label={copy.menuIndex}>
  <div class="menu-index-inner page-shell">
    {MENU.map((category) => <a href={`#${category.id}`}>{category.name[lang]}</a>)}
  </div>
</nav>

<div class="menu-layout page-shell">
  <div class="menu-content">
    {MENU.map((category, categoryIndex) => (
      <section class="menu-section" id={category.id} aria-labelledby={`${category.id}-title`}>
        <div class="menu-section-heading">
          <span aria-hidden="true">{String(categoryIndex + 1).padStart(2, '0')}</span>
          <h2 id={`${category.id}-title`}>{category.name[lang]}</h2>
        </div>
        <ul class="menu-list">
          {category.items.map((item) => (
            <li>
              <span class="dish-name">{item.name[lang]}</span>
              <span class="dish-dots" aria-hidden="true"></span>
              <span class="dish-price">{item.price} €</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <aside class="menu-aside">
    <div class="allergen-note">
      <p class="detail-label">{copy.allergensTitle}</p>
      <p>{copy.allergensBody}</p>
    </div>
    <a class="button button-primary menu-reserve" href={RESTAURANT.phoneHref} aria-label={copy.reserveAria}>{copy.reserve}</a>
  </aside>
</div>

<div class="source-note page-shell">
  <p>{copy.sourceNote}</p>
  <a class="text-link" href={RESTAURANT.mapsUrl} target="_blank" rel="noreferrer">Google Maps <span aria-hidden="true">↗</span></a>
</div>
