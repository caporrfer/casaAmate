---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Gallery from "../components/Gallery.astro";
import { heroImage } from "../data/gallery";
import chefImage from "../assets/images/chef.jpg";
import baoImage from "../assets/images/bao.jpg";
import saladImage from "../assets/images/ensalada.jpg";
import flamenquinImage from "../assets/images/flamenquin.jpg";
import { site } from "../data/site";

const featured = [
  { name: "Bao de panceta", image: baoImage, alt: "Bao de panceta de Casa Amate" },
  { name: "Ensalada ahumada", image: saladImage, alt: "Ensalada de Casa Amate" },
  { name: "Flamenquín de presa", image: flamenquinImage, alt: "Flamenquín de presa de Casa Amate" },
];
---

<BaseLayout
  title="Casa Amate · Restaurante en Jaén"
  description="Cocina mediterránea con mirada propia en el Bulevar de Jaén. Descubre la carta y reserva tu mesa en Casa Amate."
  active="home"
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="eyebrow">Cocina mediterránea · Jaén</p>
      <h1>Producto, memoria y una forma propia de cocinar.</h1>
      <p class="hero__lead">Una mesa para disfrutar sin prisa, de la mano de David Amate.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/carta/">Ver la carta</a>
        <a class="text-link" href={site.phoneHref}>Reservar · {site.phoneDisplay}</a>
      </div>
    </div>
    <div class="hero__visual" aria-label="Un bocado de la cocina de Casa Amate">
      <span class="hero__stamp">Casa<br />Amate</span>
      <Image
        class="hero__image"
        src={heroImage}
        alt="Bocado terminado a mano en Casa Amate"
        widths={[480, 640]}
        sizes="(max-width: 799px) 92vw, 46vw"
        loading="eager"
        fetchpriority="high"
      />
      <p class="hero__caption">Paseo de España, 10<br />Jaén</p>
    </div>
  </section>

  <section class="section shell" aria-labelledby="destacados-title">
    <div class="section-heading">
      <p class="eyebrow">De nuestra cocina</p>
      <h2 id="destacados-title">Tres bocados para empezar</h2>
      <a class="text-link section-heading__link" href="/carta/">Ver carta completa</a>
    </div>
    <div class="featured-grid">
      {featured.map((dish, index) => (
        <article class="featured-card">
          <div class="featured-card__image-wrap">
            <Image
              src={dish.image}
              alt={dish.alt}
              widths={[360, 520, 720]}
              sizes="(max-width: 719px) 84vw, 30vw"
              loading="lazy"
            />
            <span>{String(index + 1).padStart(2, "0")}</span>
          </div>
          <h3>{dish.name}</h3>
        </article>
      ))}
    </div>
  </section>

  <section class="story">
    <div class="story__inner shell">
      <div class="story__image-wrap">
        <Image
          src={chefImage}
          alt="David Amate, chef de Casa Amate"
          widths={[420, 640]}
          sizes="(max-width: 799px) 86vw, 40vw"
          loading="lazy"
        />
      </div>
      <div class="story__copy">
        <p class="eyebrow">La casa</p>
        <h2>Tradición inquieta.</h2>
        <p>Sabores reconocibles, mezclas inesperadas y una cocina hecha para volver.</p>
        <p class="story__signature">David Amate<br /><span>Chef</span></p>
      </div>
    </div>
  </section>

  <section class="section gallery-section shell" aria-labelledby="galeria-title">
    <div class="section-heading section-heading--wide">
      <p class="eyebrow">La experiencia</p>
      <h2 id="galeria-title">La mesa también entra por los ojos.</h2>
    </div>
    <Gallery />
  </section>

  <section class="visit" id="visitanos" aria-labelledby="visitanos-title">
    <div class="shell visit__grid">
      <div>
        <p class="eyebrow">Visítanos</p>
        <h2 id="visitanos-title">Tu mesa en el Bulevar.</h2>
        <p class="visit__address">{site.address}</p>
        <a class="button button--light" href={site.mapUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
      </div>
      <div class="visit__details">
        <div>
          <h3>Horario</h3>
          <dl>
            {site.hours.map((row) => (
              <div><dt>{row.days}</dt><dd>{row.value}</dd></div>
            ))}
          </dl>
          <p class="source-note">Horario provisional según Google Maps.</p>
        </div>
        <div>
          <h3>Reservas</h3>
          <a class="visit__phone" href={site.phoneHref}>{site.phoneDisplay}</a>
          <p>Te atendemos por teléfono.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
